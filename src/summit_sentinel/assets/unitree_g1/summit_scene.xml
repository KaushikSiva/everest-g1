<mujoco model="Summit Sentinel compressed Everest scene">
  <include file="g1_12dof.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic">
    <flag contact="enable" gravity="enable"/>
  </option>
  <statistic center="0 0 1.0" extent="12"/>

  <visual>
    <headlight diffuse="0.48 0.52 0.58" ambient="0.16 0.19 0.24" specular="0.20 0.20 0.22"/>
    <rgba haze="0.68 0.78 0.90 1"/>
    <global azimuth="132" elevation="-18" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture name="summit_sky" type="skybox" builtin="gradient"
             rgb1="0.10 0.24 0.46" rgb2="0.78 0.88 0.98" width="512" height="3072"/>
    <texture name="snow_rock" type="2d" builtin="flat" mark="random"
             rgb1="0.50 0.56 0.59" markrgb="0.23 0.28 0.31"
             width="512" height="512"/>
    <material name="snow_rock" texture="snow_rock" texuniform="true" texrepeat="3 3"
              rgba="0.78 0.83 0.86 1" reflectance="0.02" roughness="0.94"/>
    <texture name="snow_casualty_albedo" type="2d"
             file="meshes/snow_casualty_person_albedo.png"/>
    <material name="snow_casualty_material" texture="snow_casualty_albedo"
              rgba="1 1 1 1" reflectance="0.01" roughness="0.88"/>
    <mesh name="snow_casualty_person" file="snow_casualty_person.obj"/>
    <!-- The included official G1 compiler sets meshdir="meshes" globally. -->
    <hfield name="everest_compressed" file="../everest.png" size="12 12 3.0 0.10"/>
  </asset>

  <worldbody>
    <light name="sun" pos="-4 -5 12" dir="0.3 0.2 -1" directional="true"
           diffuse="0.62 0.60 0.56" castshadow="true"/>
    <light name="sky_fill" pos="3 2 7" dir="-0.2 -0.1 -1" directional="true"
           diffuse="0.14 0.20 0.30" castshadow="false"/>
    <geom name="everest_terrain" type="hfield" hfield="everest_compressed"
          material="snow_rock" friction="0.9 0.01 0.001" condim="4" priority="1"/>
    <site name="spawn_marker" pos="0 0 0.107" size="0.10 0.10 0.006" type="box"
          rgba="0.12 0.72 0.94 0.32" group="4"/>
    <!-- Detailed, static, non-colliding Robot Nurse casualty. The source GLB is
         converted to OBJ because MuJoCo does not natively load FBX/GLB. The
         target site stays fixed so proximity and dwell semantics are unchanged. -->
    <body name="downed_person" pos="1.35 0.30 0.106" mocap="true">
      <site name="downed_person_target" pos="0 0 0.18" size="0.04" type="sphere"
            rgba="0.95 0.18 0.12 0.55" group="4"/>
      <geom name="casualty_person" type="mesh" mesh="snow_casualty_person"
            material="snow_casualty_material" pos="-0.725 0 0.16"
            quat="0.7071068 0 0.7071068 0" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
